# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL_USER: Your personal Gmail address used for sending OTPs
GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD: GMAIL_APP_PASSWORD is generated at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled on the Google account)
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google Sheets Configuration (using Google Service Account)
# GOOGLE_SHEET_ID is the ID from the sheet's URL (the long string between /d/ and /edit)
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY must have its newlines preserved (when setting as Cloud Run env var, replace literal newlines with \n)
GOOGLE_SHEETS_PRIVATE_KEY=

# Random long string, generate with: openssl rand -base64 32
JWT_SECRET=

# Secret key required in the x-admin-key header to access /api/admin/stats
ADMIN_STATS_KEY=
